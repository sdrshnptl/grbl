{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Grbl for Arduino UNO",
      "type": "shell",
      "command": "${workspaceFolder}/arduino-cli_1.4.1_Linux_64bit/arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "arduino:avr:uno",
        "${workspaceFolder}/grbl/examples/grblUpload",
        "--libraries",
        "${workspaceFolder}"
      ],
      "windows": {
        "command": "${workspaceFolder}\\arduino-cli_1.4.1_Windows_64bit\\arduino-cli.exe"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Compile Grbl for Arduino UNO (Verbose)",
      "type": "shell",
      "command": "${workspaceFolder}/arduino-cli_1.4.1_Linux_64bit/arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "arduino:avr:uno",
        "${workspaceFolder}/grbl/examples/grblUpload",
        "--libraries",
        "${workspaceFolder}",
        "-v"
      ],
      "windows": {
        "command": "${workspaceFolder}\\arduino-cli_1.4.1_Windows_64bit\\arduino-cli.exe"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Upload Grbl to Arduino UNO",
      "type": "shell",
      "command": "${workspaceFolder}/arduino-cli_1.4.1_Linux_64bit/arduino-cli",
      "args": [
        "upload",
        "-p",
        "/dev/ttyACM0",
        "--fqbn",
        "arduino:avr:uno",
        "${workspaceFolder}/grbl/examples/grblUpload"
      ],
      "windows": {
        "command": "${workspaceFolder}\\arduino-cli_1.4.1_Windows_64bit\\arduino-cli.exe",
        "args": [
          "upload",
          "-p",
          "COM3",
          "--fqbn",
          "arduino:avr:uno",
          "${workspaceFolder}\\grbl\\examples\\grblUpload"
        ]
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": [],
      "dependsOn": ["Compile Grbl for Arduino UNO"]
    }
  ]
}
